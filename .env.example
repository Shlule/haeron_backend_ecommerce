# Copier ce fichier en `.env` à la racine du repo, puis remplir les valeurs.
#   cp .env.example .env
#
# `.env` est dans le .gitignore — ne jamais le commiter.
# Ces 9 variables sont toutes celles lues par `config()` dans le code
# (vérifiable avec : grep -rn 'config("' src/).


# --- Django ---------------------------------------------------------------

# Générer une clé :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=changeme-generer-une-cle-aleatoire


# --- PostgreSQL -----------------------------------------------------------

# La base doit exister avant le premier `migrate` :
#   createdb haeron
DB_NAME=haeron
DB_USER=haeron
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432


# --- HashiCorp Vault ------------------------------------------------------

# Nécessaire pour la dérivation de clés NFC (src/haeron_guitar_api/security/vault/).
# En dev :
#   vault server -dev
# affiche un « Root Token » à recopier ici.
#
# Note : VAULT_ADDR n'est pas encore une variable d'env, il est en dur dans
# settings.py (http://localhost:8200).
VAULT_TOKEN=hvs.changeme


# --- Stripe ---------------------------------------------------------------

# Clé secrète de test : dashboard Stripe > Developers > API keys
STRIPE_SECRET_KEY=sk_test_changeme

# Secret de signature du webhook. En local, il est affiché par :
#   stripe listen --forward-to localhost:8000/api/payments/stripe/webhook/
STRIPE_WEBHOOK_SECRET=whsec_changeme
